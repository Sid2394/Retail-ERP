# ASP.NET Core reads environment variables with "__" as the section separator.
# For local development prefer:  dotnet user-secrets set "Jwt:Key" "<random 48+ chars>"   (see scripts\setup-dev.ps1)
# NEVER commit real values.

# Required: JWT signing key (>= 32 characters, random)
Jwt__Key=CHANGE_ME_generate_a_long_random_value_here_min_32_chars
Jwt__Issuer=MiniERP
Jwt__Audience=MiniERP.Client
Jwt__ExpiryMinutes=480

# SQL Server connection. LocalDB (default in appsettings.json):
#   Server=(localdb)\MSSQLLocalDB;Database=MiniERP;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
# SQL Server Express / full instance with SQL login:
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=MiniERP;User Id=minierp_app;Password=<your-password>;TrustServerCertificate=True;MultipleActiveResultSets=true

# Allowed browser origins (comma-separated list is not supported; use index syntax)
Cors__Origins__0=http://localhost:5173

# Demo data. Enabled automatically by appsettings.Development.json. Leave disabled in production.
Seed__Enabled=false
Seed__DefaultPassword=
